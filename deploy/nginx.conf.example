# nginx in front of the Spore API. TLS via certbot (`certbot --nginx -d spore.example`).
# The API trusts X-Forwarded-* from loopback (TRUST_PROXY=loopback) and does its own compression,
# ETags and security headers; nginx terminates TLS, buffers nothing on the SSE stream and caps the
# request body for the upload route.
upstream spore_api { server 127.0.0.1:8793; keepalive 32; }

server {
    listen 80;
    listen [::]:80;
    server_name spore.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name spore.example;

    ssl_certificate     /etc/letsencrypt/live/spore.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/spore.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/spore.access.log;
    client_max_body_size 4m;          # /api/upload is capped at 3 MB by the API itself

    location /api/events {
        proxy_pass http://spore_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;          # SSE: deliver each event as it is written
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://spore_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;      # the upload waits on a Pages deploy (up to 120 s)
    }
}
