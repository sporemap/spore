# Spore API environment — copy to deploy/.env (PM2 reads it via ecosystem.config.cjs; systemd via
# EnvironmentFile). Never commit the real file (.gitignore has .env*). Every variable is validated
# at boot by server/lib/config.mjs; a bad value stops the process with the list of problems.
# No private key is ever read by the server. The treasury keypair stays outside the repo (DEPLOY.md).

# ---- network --------------------------------------------------------------------------------
# HTTP port the API listens on (the reverse proxy forwards to it).
PORT=8793
# JSON-RPC endpoint. Helius: https://mainnet.helius-rpc.com/?api-key=<key>. The key never reaches
# the browser (it only talks to /api/rpc) and is redacted in logs.
RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket endpoint for logsSubscribe. Derived from RPC_URL (https→wss) when unset; Helius-style
# ?api-key= URLs derive correctly.
#WS_URL=wss://mainnet.helius-rpc.com/?api-key=<key>
# Request budget per second shared by indexer, refresh loop and the browser proxy (token bucket;
# a 429 pauses everything with backoff). Default 4 on the public RPC, 40 elsewhere. Helius
# Business handles 40–50 comfortably.
#RPC_RPS=40
# Parallel RPC requests in flight (1–64). 4 public, 8 on a paid RPC.
#CONCURRENCY=8

# ---- launchpad (DESIGN §11) -----------------------------------------------------------------
# Platform wallet: fee-split shareholder, launch-fee recipient and the "ours" marker.
PLATFORM_WALLET=FcbEAMqBvJVsfcFWDbED7geyBLR88ypcY88BoUSgmeT5
# Fee split in bps: child creator, parent creator, grandparent creator, platform (sum 10000).
# Default = two shareholders, creator 50 / Spore 50. Zero slices are dropped.
SPLIT_BPS=5000,0,0,5000
# Launch fee in SOL transferred to PLATFORM_WALLET inside the create transaction (0 disables; owner decision 2026-10-19: no launch fee, users pay only network fees — Spore earns through the 50% creator-fee share).
LAUNCH_FEE_SOL=0
# ours: list only coins launched through Spore (production). all: the whole pump.fun tree (dev).
SHOW=ours

# ---- metadata host (DESIGN §11.3) ----------------------------------------------------------
# Public host serving the self-hosted token metadata (/m/<sha256>.json and images).
PAGES_DOMAIN=spore-2x6.pages.dev
# Cloudflare Pages project that `wrangler pages deploy` publishes to. The API token is read at
# deploy time from $HOME/.cloudflare-token (mode 600), never from this file.
PAGES_PROJECT=spore
# Cloudflare account that owns the Pages project (wrangler needs it with an account-scoped token).
CLOUDFLARE_ACCOUNT_ID=
# Directory holding the published files (m/, _headers, index.html). Default deploy/pages/public.
#META_DIR=/opt/spore/deploy/pages/public

# ---- storage & indexer ----------------------------------------------------------------------
# sqlite file (spore.sqlite, WAL) and the image cache (img/). Back this directory up (DEPLOY.md).
#DATA_DIR=/opt/spore/server/data
# 1 = run the resumable backfill of the whole pump.fun tree at boot (minutes on Helius, hours on
# the public RPC); 0 = live subscription only.
BACKFILL=1
# Development only: stop resolving curves after this many (unset = unlimited).
#BACKFILL_LIMIT=400
# Refresh tick (hot coins) and the window over which every tracked curve is re-read once.
REFRESH_MS=30000
FULL_REFRESH_MS=1200000
# 0 skips the per-coin getSignaturesForAddress creation-time probe during the backfill.
CREATED_AT_PROBE=1
# Treasury endpoint cache (ms, ≥ 5000).
TREASURY_TTL_MS=60000

# ---- HTTP hardening --------------------------------------------------------------------------
# Comma-separated CORS allowlist of extra origins (scheme://host[:port]). Production is same-origin
# (the API serves web/dist) and needs none; a separate Vite dev host needs its origin here.
#ORIGINS=http://localhost:5174
# express "trust proxy": loopback (nginx/Caddy on the same box, default), true (any upstream —
# only behind a proxy you control), a hop count, or IPs/subnets ("10.0.0.0/8, 127.0.0.1").
# Client IPs for rate limits and logs come from X-Forwarded-For only through a trusted proxy.
TRUST_PROXY=loopback
# Strict-Transport-Security: auto (only on requests the trusted proxy marks https), 1 (always), 0 (never).
HSTS=auto
# Fraction of successful fast requests to log (errors and requests over 1 s are always logged).
LOG_SAMPLE=0.1
# Per-IP rate limits (requests per window; windows are fixed: api/img/rpc 1 min, upload/spawned 10 min).
#RATE_API=300
#RATE_IMG=900
#RATE_RPC=60
#RATE_UPLOAD=5
#RATE_SPAWNED=20
# Extra connect-src hosts for the SPA's Content-Security-Policy (comma-separated). Not needed:
# the browser reaches the chain only through /api/rpc.
#CSP_CONNECT=
# Built web app directory served with the SPA fallback (default ../web/dist).
#DIST_DIR=/opt/spore/web/dist
