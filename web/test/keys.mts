import { Connection, PublicKey, Keypair, TransactionMessage, VersionedTransaction } from "@solana/web3.js";
import { TOKEN_PROGRAM_ID } from "@solana/spl-token";
import BN from "bn.js";
import { OnlinePumpSdk, PUMP_SDK, isBondingCurveMigrated, isLegacyQuoteMint } from "@pump-fun/pump-sdk";
import { hopsFor, splitShares, type Chain } from "../src/lib/pump/index.ts";
const conn = new Connection("https://api.mainnet-beta.solana.com", "confirmed");
const online = new OnlinePumpSdk(conn);
const PROBE = new PublicKey("dBs75Gf7RXQMAsMLuTLYdH2fHV1ac9zgCEh6zC7TxXs");
const PARENT = new PublicKey("8M8hAuusNmKg6dEwCr7cHmHcaBwdJbPDxM5vEGAapump");
const COIN = new PublicKey("GtsYUp4Gxbyag3c1So1jvfPu54AdU47HGeySBQEvpump");
const keysOf = (ixs: any[]) => { const s = new Map<string, number>(); for (const ix of ixs) { s.set(ix.programId.toBase58(), (s.get(ix.programId.toBase58()) ?? 0) + 1); for (const k of ix.keys) s.set(k.pubkey.toBase58(), (s.get(k.pubkey.toBase58()) ?? 0) + 1); } return s; };
const size = (payer: PublicKey, ixs: any[]) => { try { return new VersionedTransaction(new TransactionMessage({ payerKey: payer, recentBlockhash: "11111111111111111111111111111111", instructions: ixs }).compileToV0Message()).serialize().length; } catch (e) { return "OVER:" + (e as Error).message; } };
const resolved = await online.resolveQuoteMint(PARENT);
const pc = await online.fetchBondingCurve(PARENT); const gc = await online.fetchBondingCurve(pc.quoteMint);
const mint = Keypair.generate();
const create = await PUMP_SDK.createV2Instruction({ mint: mint.publicKey, name: "Spore Test", symbol: "SPORET", uri: "https://ipfs.io/ipfs/bafkreigexample", creator: PROBE, user: PROBE, mayhemMode: false, quoteMint: PARENT, quoteTokenProgram: resolved.quoteTokenProgram, holderReward: false, pumpQuote: resolved.pumpQuote!.accounts });
const cfg = await PUMP_SDK.createFeeSharingConfig({ creator: PROBE, mint: mint.publicKey, pool: null });
const upd = await PUMP_SDK.updateFeeSharesV2({ authority: PROBE, mint: mint.publicKey, currentShareholders: [PROBE], newShareholders: splitShares(PROBE, pc.creator, gc.creator, PROBE), quoteMint: PARENT, quoteTokenProgram: resolved.quoteTokenProgram, bondingCurveComplete: false });
console.log("create: keys", create.keys.length, "data", create.data.length, "size", size(PROBE, [create]));
console.log("cfg+upd: keys", cfg.keys.length + upd.keys.length, "size", size(PROBE, [cfg, upd]));
console.log("all: size", size(PROBE, [create, cfg, upd]));
const q = await online.fetchPumpQuote(COIN); const coins = [q!.curve, ...(q!.curve.chain ?? [])];
const prog = async (m: PublicKey) => (isLegacyQuoteMint(m) ? TOKEN_PROGRAM_ID : (await conn.getAccountInfo(m))!.owner);
const chain: Chain = []; for (const c of coins) { const qm = c.bondingCurve.quoteMint; chain.push({ mint: c.mint.toBase58(), quoteMint: isLegacyQuoteMint(qm) ? null : qm.toBase58(), tokenProgram: (await prog(c.mint)).toBase58(), quoteTokenProgram: (await prog(qm)).toBase58(), migrated: isBondingCurveMigrated(c.bondingCurve), depth: c.bondingCurve.depth }); }
const swap = await PUMP_SDK.multiHopSwapInstructions({ user: PROBE, hops: hopsFor(chain, "buy"), side: "buy", amountIn: new BN(10_000_000), minAmountOut: new BN(1) });
console.log("swap3: ixs", swap.length, "size", size(PROBE, swap));
const all = new Map<string, string[]>();
const tag = (m: Map<string, number>, t: string) => { for (const k of m.keys()) all.set(k, [...(all.get(k) ?? []), t]); };
tag(keysOf([create]), "create"); tag(keysOf([cfg, upd]), "fees"); tag(keysOf(swap), "swap");
console.log("\nKEY\tUSES"); for (const [k, v] of all) console.log(k, v.join(","));
